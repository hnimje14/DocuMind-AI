# ============================================================================
# DocuMind AI — Intelligent Document Q&A System (RAG)
# Environment Configuration Template (Copy to .env)
# ============================================================================

# Application Settings
APP_NAME="DocuMind AI"
APP_ENV="development"
LOG_LEVEL="INFO"

# API Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_URL="http://127.0.0.1:8000"

# LLM Configuration
# Supported LLM_PROVIDER values:
#   - "mock"       : Grounded Extractive RAG Mode (no API key required; synthesizes directly from retrieved evidence)
#   - "openai"     : OpenAI API (https://api.openai.com/v1)
#   - "groq"       : Groq Cloud API (https://api.groq.com/openai/v1)
#   - "openrouter" : OpenRouter API (https://openrouter.ai/api/v1)
#   - "gemini"     : Google Gemini OpenAI-compatible endpoint
LLM_PROVIDER="mock"
LLM_API_KEY="your-api-key-here"
LLM_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"
NORMALIZE_EMBEDDINGS=true
USE_HASH_EMBEDDINGS_FALLBACK=false

# Document Ingestion & Semantic Chunking Defaults
MAX_FILE_SIZE_MB=25
DEFAULT_CHUNK_SIZE=350
DEFAULT_CHUNK_OVERLAP=50

# Retrieval Defaults
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.05

# Storage & Persistence Paths
DATA_DIR="./data"
UPLOAD_DIR="./data/uploads"
VECTORSTORE_DIR="./data/vectorstore"
SQLITE_DB_PATH="./data/rag_metadata.db"
EVALUATION_DIR="./evaluation"

# Security & Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
